{
    "name": "inet-services/eppitnic",
    "description": "REST API and command line for registrars of the Italian domain registry (nic.it), over EPP",
    "license": "BSD-3-Clause",
    "require": {
        "php": ">=8.2",
        "ext-curl": "*",
        "ext-simplexml": "*",
        "ext-dom": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-posix": "*",
        "ext-intl": "*",
        "gabordemooij/redbean": "^5.7",
        "slim/slim": "^4.0",
        "slim/psr7": "^1.8",
        "firebase/php-jwt": "^7.1",
        "spomky-labs/otphp": "^11.0",
        "phpmailer/phpmailer": "^7.1",
        "web-auth/webauthn-lib": "^5.3",
        "spomky-labs/pki-framework": "^1.6",
        "psr/clock": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Eppitnic\\": "src/"
        },
        "files": [
            "config/constants.php"
        ]
    },
    "require-dev": {
        "ext-pdo_sqlite": "*",
        "phpunit/phpunit": "^11",
        "symfony/clock": "^7.4",
        "spomky-labs/cbor-php": "^3.4"
    },
    "autoload-dev": {
        "psr-4": {
            "Eppitnic\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
